// Cloudflare Workers + Static Assets. Production deploy: `npx wrangler deploy`
// (run after `npm run build`, which writes the site to ./dist).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ranco",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Runs before wrangler deploy/preview/dev upload anything. Refuses
  // wrangler deploy from any branch but main in Workers Builds, and refuses
  // to deploy a preview build anywhere (see scripts/ci-guard.mjs).
  "build": { "command": "node scripts/ci-guard.mjs wrangler" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Page requests go through the Worker (to apply MAINTENANCE_MODE);
    // images (/_media, /assets), fonts, scripts, favicon.ico, robots.txt and
    // the sitemaps are always served straight from assets, never as a 503 page.
    // Each page is its own prerendered HTML file. Unknown URLs get the real
    // 404 page (dist/404.html) with a 404 status; no SPA fallback.
    "not_found_handling": "404-page",
    "run_worker_first": ["/*", "!/assets/*", "!/_media/*", "!/favicon.ico", "!/robots.txt", "!/sitemap.xml", "!/sitemap.txt"]
  },
  "vars": {
    // Production state: OFF. The coming-soon page is served as a normal,
    // indexable page: 200 for "/", 404 for unknown URLs.
    //   "off" → normal responses (production default).
    //   "on"  → genuine temporary outage only: every page returns the
    //           maintenance page as 503 + Retry-After. Turn it back off as
    //           soon as the outage ends; long-running 503s reduce crawling.
    // Fail-safe: a missing, empty or misspelt value is treated as "on" (and
    // logs a warning), so never delete this line.
    // Change it here and push to main; `wrangler deploy` replaces any
    // variables set in the Cloudflare dashboard with these values.
    "MAINTENANCE_MODE": "off",
    // Retry-After in seconds, used only while "on" (259200 = 3 days).
    // Invalid values fall back to 3 days.
    "MAINTENANCE_RETRY_AFTER_SECONDS": "259200"
  },
  // Worker Previews (npx wrangler preview, run by Workers Builds for branches
  // other than main). Previews do not inherit the top-level vars, so they are
  // repeated here: without MAINTENANCE_MODE the fail-safe would show the 503
  // page. Production (npx wrangler deploy) uses only the top-level settings.
  "previews": {
    "vars": {
      "MAINTENANCE_MODE": "off",
      "MAINTENANCE_RETRY_AFTER_SECONDS": "259200"
    }
  }
}
