// Cloudflare Workers + Static Assets. Production deploy: `npx wrangler deploy`
// (run after `npm run build`, which writes the site to ./dist).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ranco",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Page requests go through the Worker (to apply maintenance mode);
    // images, fonts, scripts and robots.txt are served straight from assets.
    // No SPA fallback: the site has no client-side routes, so unknown URLs
    // and missing files return 404 once maintenance is off.
    "run_worker_first": ["/*", "!/assets/*", "!/robots.txt"]
  },
  "vars": {
    // Production state: maintenance ON.
    //   "on"  → every page returns the maintenance page as 503 + Retry-After.
    //   "off" → the site is served normally (200; 404 for unknown URLs).
    // Fail-safe: a missing, empty or misspelt value is treated as "on".
    // Change it here and push to main; `wrangler deploy` replaces any
    // variables set in the Cloudflare dashboard with these values.
    "MAINTENANCE_MODE": "on",
    // Retry-After in seconds (259200 = 3 days). Invalid values fall back to 3 days.
    "MAINTENANCE_RETRY_AFTER_SECONDS": "259200"
  }
}
