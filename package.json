{
  "name": "ranco",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/media.mjs build && vite",
    "media": "node scripts/media.mjs build",
    "build": "node scripts/ci-guard.mjs build",
    "build:preview": "node scripts/ci-guard.mjs preview && VITE_SITE_ENV=preview npm run build:site",
    "build:site": "node scripts/media.mjs build && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir build-ssr && node scripts/prerender.mjs && node scripts/media.mjs emit",
    "preview": "npm run build && wrangler dev",
    "typecheck": "node scripts/media.mjs manifest && tsc -b",
    "lint": "eslint .",
    "test:unit": "node --test scripts/*.test.mjs",
    "test": "node scripts/http-test.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run build && npm test && wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "sharp": "^0.34.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.1"
  }
}
